# --- Application ---
APP_NAME=PLLM Benchmark
API_PREFIX=/api
DEBUG=false

# --- Database ---
# Async SQLAlchemy URL (asyncpg driver). Inside docker-compose, host is `db`.
DATABASE_URL=postgresql+asyncpg://pllm:pllm@db:5432/pllm_benchmark

# --- CORS ---
# Comma-separated allowed origins for the local frontend.
CORS_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1:8080
